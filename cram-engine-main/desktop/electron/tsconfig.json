{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "../dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "composite": true
  },
  "include": ["**/*.ts", "**/*.cts", "../src/**/*.d.ts", "../node_modules/tesseract.js/src/index.d.ts"],
  "exclude": ["../src"]
}
